[Unit]
Description=WebSocket Daemon
Requires=environment.service gateway-config-backend-sslkey.service
Wants=network-online.target lemonbeatd.service lwm2mserver.service
After=environment.service network-online.target gateway-config-backend-sslkey.service lemonbeatd.service lwm2mserver.service
ConditionPathExists=/etc/enable-websocketd

[Service]
Type=simple
Restart=on-failure
RestartSec=60
MemoryMax=15M
Environment=RUST_LOG=info
ExecStart=/usr/bin/websocketd

[Install]
WantedBy=multi-user.target
